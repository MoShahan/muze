{
  "expo": {
    "name": "Muze",
    "slug": "muze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muze",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E6E9EF",
    "primaryColor": "#1C1E22",
    "ios": {
      "bundleIdentifier": "com.moshahan.muze",
      "icon": "./assets/images/icon.png",
      "backgroundColor": "#E6E9EF"
    },
    "android": {
      "package": "com.moshahan.muze",
      "backgroundColor": "#E6E9EF",
      "adaptiveIcon": {
        "backgroundColor": "#F1EFE9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6E9EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C1E22",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Muze needs access to audio files so you can play music stored on this device.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["audio"]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "expo-asset",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "bundleIdentifier": "com.moshahan.muze.widgets",
          "groupIdentifier": "group.com.moshahan.muze",
          "widgets": [
            {
              "name": "MuzeNowPlaying",
              "displayName": "Muze",
              "description": "Album art, track info, and play controls",
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal",
                "initialLayout": "./src/widgets/muze-now-playing.tsx"
              }
            }
          ]
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d4b5179d-baa1-440a-b6d3-0574f86d4623"
      }
    }
  }
}
